<html lang="en" prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
	<head>
		<title>{% block title %}{% endblock %}</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{% block social_metadata %}
		{% from "social_meta.jinja2" import render_social_metadata %}
		{{ render_social_metadata(
			'Tod and Lorna .com',
			"Tod and Lorna's personal blog and home on the internet.",
			'/',
			image_alt='Tod and Lorna logo'
		) }}
		{% endblock %}
		<!--[if lte IE 8]><script src="/assets/js/ie/html5shiv.js"></script><![endif]-->
		<link rel="stylesheet" href="/assets/css/main.css" />
		<link rel="stylesheet" href="/assets/css/tnl.css" />
		<!--[if lte IE 8]><link rel="stylesheet" href="/assets/css/ie8.css" /><![endif]-->
		{{ extra_headers }}
	</head>
	<body>
		<!-- Header -->
			<section id="header">
				<header>
					<span class="image avatar"><img src="/images/logo.gif" alt="Logo" /></span>
					<h1 id="logo"><a href="/">Tod and Lorna</a></h1>
					<p><br />
					<a href="https://todandlorna.com/tnlblog/atom.xml" class="inline_icon"><i class="icon fa-solid fa-rss"></i></a>
					Enjoy the stay =cP</p>
				</header>
				<nav id="nav">
					<ul>
						<li><a href="/" {% if is_home_not_supported %}class="active"{% endif %}>Home</a></li>
						<li><a href="/tnlblog/listing1.html" {% if is_blog_not_supported %}class="active"{% endif %}>TnL Blog</a></li>
					</ul>
					<div class="site_search" data-search-component>
						<form action="https://duckduckgo.com/" method="get" data-search-form data-search-limit="5">
							<input name="sites" type="hidden" value="todandlorna.com" />
							<label for="site_search_input">Search the site</label>
							<div class="site_search_controls">
								<input id="site_search_input" name="q" type="search" autocomplete="off" required />
								<button type="submit">Search</button>
							</div>
						</form>
						<div class="site_search_output" data-search-output hidden>
							<div data-search-status role="status" aria-live="polite"></div>
							<ol data-search-results></ol>
							<a href="/search/" data-search-more>See all results</a>
						</div>
					</div>
				</nav>
				<footer>
					<ul class="icons">
						<li><a href="https://twitter.com/todpunk" class="icon fa-twitter"><span class="label">Twitter</span></a></li>
						<li><a href="https://facebook.com/todpunk" class="icon fa-facebook"><span class="label">Facebook</span></a></li>
						<li><a href="https://github.com/todpunk" class="icon fa-github"><span class="label">Github</span></a></li>
						<li><a href="mailto:sitestuff@todandlorna.com" class="icon fa-envelope"><span class="label">Email</span></a></li>
					</ul>
				</footer>
			</section>

		<!-- Wrapper -->
			<div id="wrapper">

				<!-- Main -->
					<div id="main">

						<!-- One -->
						{% block content %}
						{% endblock %}
					</div>

				<!-- Footer -->
				<section id="footer">
					<div class="container">
						<ul class="copyright">
							<li>&copy; 2003-2025, TodandLorna.com is an effort of the Catalyst Community. Generated with <a href="https://github.com/catalystcommunity/pysocha/">pysocha</a>.</li>
						</ul>
					</div>
				</section>
			</div>

		<!-- Scripts -->
		<script src="/assets/js/jquery.min.js"></script>
		<script src="/assets/js/jquery.scrollzer.min.js"></script>
		<script src="/assets/js/jquery.scrolly.min.js"></script>
		<script src="/assets/js/skel.min.js"></script>
		<script src="/assets/js/util.js"></script>
		<!--[if lte IE 8]><script src="/assets/js/ie/respond.min.js"></script><![endif]-->
		<script src="/assets/js/main.js"></script>
		<script src="/assets/js/search.js" type="module"></script>
		{{ extra_scripts }}
		{% block extra_footer %}{% endblock %}
	</body>
</html>
