{% extends "base.jinja2" %}
{% from "social_meta.jinja2" import render_social_metadata %}
{% block social_metadata %}
	{{ render_social_metadata(
		'Tags in Articles from TnL',
		'Browse Tod and Lorna articles by tag.',
		'/tnlblog/tags.html',
		image_alt='Tod and Lorna logo'
	) }}
{% endblock %}
{% block title %}Tags in Articles from TnL{% endblock %}
{% block content %}

	<section id="one">
		<div class="container">
			<header class="blog_listing">
				<h2>Tags in Articles from TnL</h2>
			</header>
			{% for tag, posts in tags.items() %}
				<div class="tag_list_item">
					<h3><a href="tag_{{ tag.replace(' ', '_') }}1.html">{{ tag }}: {{ posts|length }} posts</a></h3>
				</div>
			{% endfor %}
		</div>
	</section>

{% endblock %}
