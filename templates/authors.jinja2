{% extends "base.jinja2" %}
{% from "social_meta.jinja2" import render_social_metadata %}
{% block social_metadata %}
	{{ render_social_metadata(
		'Authors of Articles from TnL',
		'Browse Tod and Lorna articles by author.',
		'/tnlblog/authors.html',
		image_alt='Tod and Lorna logo'
	) }}
{% endblock %}
{% block title %}Authors of Articles from TnL{% endblock %}
{% block content %}

	<section id="one">
		<div class="container">
			<header class="blog_listing">
				<h2>Authors in Articles from TnL</h2>
			</header>
			{% for author, posts in authors.items() %}
				<div class="author_list_item">
					<h3><a href="{{ author.replace(' ', '_') }}1.html">{{ author }}: {{ posts|length }} posts</a></h3>
				</div>
			{% endfor %}
		</div>
	</section>

{% endblock %}
